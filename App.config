<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!-- 3 — DPI awareness via .NET runtime configuration (recommended for .NET 4.7+).
       Combined with app.manifest <dpiAwareness>PerMonitorV2</dpiAwareness> this
       gives the cleanest per-monitor DPI scaling without any P/Invoke side-effects. -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
